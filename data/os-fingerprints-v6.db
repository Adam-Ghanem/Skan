# Original Skan IPv6 profiles; generic laboratory signatures, not authoritative fingerprints.
# This file is independent from data/os-fingerprints.db.

Fingerprint SkanIPv6LinuxGeneric
ID=skan-v6-linux-generic
SPECIFICITY=13
ADDRESS_FAMILY=IPv6
Class Skan | Linux IPv6 | generic | general-purpose
TTL=64
WINDOW=64240
MSS=1440
WSCALE=7
SACK=Y
TIMESTAMP=Y
TCP_OPTIONS=MSS,SACK,TS,NOP,WS
RESPONSE_BEHAVIOR=SYN_ACK
RESPONSE_PRESENCE=YES
UDP_RESPONSE_BEHAVIOR=UDP_RESPONSE

Fingerprint SkanIPv6WindowsGeneric
ID=skan-v6-windows-generic
SPECIFICITY=11
ADDRESS_FAMILY=IPv6
Class Skan | Windows IPv6 | generic | general-purpose
