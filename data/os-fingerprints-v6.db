WINDOW=65535
MSS=1440
WSCALE=8
SACK=Y
TIMESTAMP=Y
TCP_OPTIONS=MSS,NOP,WS,SACK,TS
RESPONSE_BEHAVIOR=SYN_ACK
RESPONSE_PRESENCE=YES

