# Skan project-owned IPv6 active OS fingerprint corpus.
# Clean-room family/style signatures. IPv6 has no IPv4 DF bit, so these profiles
# focus on hop-limit, TCP window, MSS, scaling and option behavior.

# Modern Linux IPv6 style with 1440 MSS on a 1500-byte Ethernet path.
Fingerprint IPv6LinuxModern64240
ID=skan-v6-linux-modern-64240
SPECIFICITY=17
ADDRESS_FAMILY=IPv6
Class Linux | Linux kernel IPv6 | modern | general-purpose
TTL_RANGE=45-64
WINDOW=64240
MSS=1440
WSCALE=7
SACK=Y
TIMESTAMP=Y
TCP_OPTIONS=MSS,SACK,TS,NOP,WS
RESPONSE_BEHAVIOR=SYN_ACK
RESPONSE_PRESENCE=YES
ICMP_TTL_RANGE=45-64

